{
  "schemaVersion": 1,
  "version": "0.1.0",
  "license": "MIT",
  "source": "https://github.com/particular-labs/toolgraft",
  "compatibility": {
    "minExtension": "0.1.0",
    "minEngine": 1
  },
  "routeScoped": true,
  "id": "community.playground",
  "title": "ToolGraft playground",
  "description": "Tools for ToolGraft playground.",
  "matches": ["http://localhost/tasks*", "http://localhost/"],
  "runtime": {
    "kind": "script",
    "world": "USER_SCRIPT",
    "runAt": "document_idle",
    "entry": "bundle.js"
  },
  "permissions": {
    "hosts": ["http://localhost/*"],
    "network": "same-origin",
    "pageStorage": false
  }
}
