{
  "schemaVersion": 1,
  "version": "0.1.0",
  "license": "MIT",
  "source": "https://github.com/particular-labs/toolgraft",
  "compatibility": {
    "minExtension": "0.1.0",
    "minEngine": 1
  },
  "routeScoped": true,
  "id": "community.hacker-news-api",
  "title": "Hacker News API",
  "description": "Tools for Hacker News API.",
  "matches": ["https://news.ycombinator.com/*"],
  "runtime": {
    "kind": "api",
    "format": "webmcp-today@1",
    "definition": "webmcp-package.json"
  },
  "permissions": {
    "hosts": [
      "https://news.ycombinator.com/*",
      "https://hacker-news.firebaseio.com/*"
    ],
    "network": "declared-origins",
    "pageStorage": false
  }
}
